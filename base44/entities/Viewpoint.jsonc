  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "destination_id": {
      "type": "string",
      "title": "Destination ID"
    },
    "destination_name": {
      "type": "string",
      "title": "Destination Name"
    },
    "region_id": {
      "type": "string",
      "title": "Region ID"
    },
    "region_name": {
      "type": "string",
      "title": "Region Name"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "best_time": {
      "type": "string",
      "title": "Best Time"
    },
    "access": {
      "type": "string",
      "title": "Access"
    },
    "photos": {
      "type": "array",
      "title": "Photos",
      "items": {
        "type": "string"
      }
    },
    "latitude": {
      "type": "number",
      "title": "Latitude"
