{
  "name": "Region",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "slug": {
      "type": "string",
      "title": "Slug"
    },
    "overview": {
      "type": "string",
      "title": "Overview"
    },
    "highlights": {
      "type": "string",
      "title": "Highlights"
    },
    "best_for": {
      "type": "string",
      "title": "Best For"
    },
    "best_season": {
      "type": "string",
      "title": "Best Season"
    },
    "travel_time_from_airport": {
      "type": "string",
      "title": "Travel Time From Airport"
    },
    "hero_image": {
      "type": "string",
      "title": "Hero Image",
      "format": "uri"
    },
    "photos": {
      "type": "array",
      "title": "Photos",
      "items": {
        "type": "string"
      }
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    }
  },
  "required": [
    "name"
  ]
}