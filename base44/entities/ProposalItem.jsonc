{
  "name": "ProposalItem",
  "type": "object",
  "properties": {
    "proposal_id": {
      "type": "string",
      "title": "Proposal ID"
    },
    "travel_project_id": {
      "type": "string",
      "title": "Travel Project ID"
    },
    "day_number": {
      "type": "number",
      "title": "Day Number",
      "default": 1
    },
    "item_type": {
      "type": "string",
      "title": "Item Type",
      "enum": [
        "Accommodation",
        "Transfer",
        "Activity",
        "Restaurant",
        "Guide",
        "Car Rental",
        "Boat Trip",
        "Experience",
        "Other"
      ]
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "supplier_id": {
      "type": "string",
      "title": "Supplier ID"
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "start_time": {
      "type": "string",
      "title": "Start Time"
    },
    "end_time": {
      "type": "string",
      "title": "End Time"
    },
    "internal_cost": {
      "type": "number",
      "title": "Internal Cost",
      "default": 0
    },
    "customer_price": {
      "type": "number",
      "title": "Customer Price",
      "default": 0
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    },
    "latitude": {
      "type": "number",
      "title": "Latitude"
    },
    "longitude": {
      "type": "number",
      "title": "Longitude"
    }
  },
  "required": [
    "proposal_id",
    "item_type",
    "title"
  ]
}