{
  "name": "Restaurant",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "destination_id": {
      "type": "string",
      "title": "Destination ID"
    },
    "destination_name": {
      "type": "string",
      "title": "Destination Name"
    },
    "region_id": {
      "type": "string",
      "title": "Region ID"
    },
    "region_name": {
      "type": "string",
      "title": "Region Name"
    },
    "cuisine": {
      "type": "string",
      "title": "Cuisine"
    },
    "price_range": {
      "type": "string",
      "title": "Price Range",
      "enum": [
        "budget",
        "mid_range",
        "premium",
        "luxury"
      ]
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "speciality": {
      "type": "string",
      "title": "Signature Dish"
    },
    "dietary_options": {
      "type": "string",
      "title": "Dietary Options"
    },
    "ambience": {
      "type": "string",
      "title": "Ambience"
    },
    "photos": {
      "type": "array",
      "title": "Photos",
      "items": {
        "type": "string"
      }
    },
    "latitude": {
      "type": "number",
      "title": "Latitude"
    },
    "longitude": {
      "type": "number",
      "title": "Longitude"
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    }
  },
  "required": [
    "name"
  ]
}