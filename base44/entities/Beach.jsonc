{
  "name": "Beach",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "destination_id": {
      "type": "string",
      "title": "Destination ID"
    },
    "destination_name": {
      "type": "string",
      "title": "Destination Name"
    },
    "region_id": {
      "type": "string",
      "title": "Region ID"
    },
    "region_name": {
      "type": "string",
      "title": "Region Name"
    },
    "type": {
      "type": "string",
      "title": "Beach Type",
      "enum": [
        "sandy",
        "pebble",
        "rocky",
        "concrete"
      ]
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "best_for": {
      "type": "string",
      "title": "Best For"
    },
    "facilities": {
      "type": "string",
      "title": "Facilities"
    },
    "photos": {
      "type": "array",
      "title": "Photos",
      "items": {
        "type": "string"
      }
    },
    "latitude": {
      "type": "number",
      "title": "Latitude"
    },
    "longitude": {
      "type": "number",
      "title": "Longitude"
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    }
  },
  "required": [
    "name"
  ]
}