{
  "name": "Attraction",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "slug": {
      "type": "string",
      "title": "Slug"
    },
    "destination_id": {
      "type": "string",
      "title": "Destination ID"
    },
    "destination_name": {
      "type": "string",
      "title": "Destination Name"
    },
    "region_id": {
      "type": "string",
      "title": "Region ID"
    },
    "region_name": {
      "type": "string",
      "title": "Region Name"
    },
    "category": {
      "type": "string",
      "title": "Category",
      "enum": [
        "historical",
        "cultural",
        "natural",
        "religious",
        "landmark"
      ]
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "photos": {
      "type": "array",
      "title": "Photos",
      "items": {
        "type": "string"
      }
    },
    "best_time": {
      "type": "string",
      "title": "Best Time"
    },
    "entry_fee": {
      "type": "string",
      "title": "Entry Fee"
    },
    "duration": {
      "type": "string",
      "title": "Typical Visit Duration"
    },
    "latitude": {
      "type": "number",
      "title": "Latitude"
    },
    "longitude": {
      "type": "number",
      "title": "Longitude"
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    }
  },
  "required": [
    "name"
  ]
}