{
  "name": "BookingRequest",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "title": "Full Name"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "whatsapp": {
      "type": "string",
      "title": "WhatsApp Number"
    },
    "departure_date": {
      "type": "string",
      "title": "Preferred Departure Date"
    },
    "guests": {
      "type": "number",
      "title": "Number of Guests"
    },
    "from_uk": {
      "type": "boolean",
      "title": "Travelling from UK"
    },
    "airport": {
      "type": "string",
      "title": "Departure Airport"
    },
    "activity_level": {
      "type": "string",
      "title": "Activity Level",
      "enum": [
        "easy",
        "moderate",
        "active"
      ]
    },
    "dietary": {
      "type": "string",
      "title": "Dietary Requirements"
    },
    "notes": {
      "type": "string",
      "title": "Additional Notes"
    },
    "source": {
      "type": "string",
      "title": "How Did You Hear About Us",
      "enum": [
        "TikTok",
        "Instagram",
        "Facebook",
        "Google",
        "Friend",
        "Other"
      ]
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "new",
        "contacted",
        "confirmed",
        "cancelled"
      ],
      "default": "new"
    }
  },
  "required": [
    "full_name",
    "email",
    "whatsapp",
    "departure_date",
    "guests"
  ]
}