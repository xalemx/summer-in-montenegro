{
  "name": "Route",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "slug": {
      "type": "string",
      "title": "Slug"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "duration_days": {
      "type": "number",
      "title": "Duration (days)"
    },
    "difficulty": {
      "type": "string",
      "title": "Difficulty",
      "enum": [
        "easy",
        "moderate",
        "challenging"
      ]
    },
    "transport_mode": {
      "type": "string",
      "title": "Transport Mode",
      "enum": [
        "car",
        "boat",
        "mixed",
        "hiking"
      ]
    },
    "region_ids": {
      "type": "array",
      "title": "Region IDs",
      "items": {
        "type": "string"
      }
    },
    "region_names": {
      "type": "string",
      "title": "Region Names"
    },
    "destination_ids": {
      "type": "array",
      "title": "Destination IDs (ordered)",
      "items": {
        "type": "string"
      }
    },
    "destination_names": {
      "type": "string",
      "title": "Destinations (ordered)"
    },
    "highlights": {
      "type": "string",
      "title": "Highlights"
    },
    "best_season": {
      "type": "string",
      "title": "Best Season"
    },
    "photos": {
      "type": "array",
      "title": "Photos",
      "items": {
        "type": "string"
      }
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    }
  },
  "required": [
    "name"
  ]
}