{
  "name": "Supplier",
  "type": "object",
  "properties": {
    "supplier_name": {
      "type": "string",
      "title": "Supplier Name"
    },
    "category": {
      "type": "string",
      "title": "Category",
      "enum": [
        "Hotel",
        "Apartment",
        "Villa",
        "Transfer Company",
        "Private Driver",
        "Boat Operator",
        "Activity Provider",
        "Restaurant",
        "Tour Guide",
        "National Park",
        "Other"
      ]
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "contact_name": {
      "type": "string",
      "title": "Contact Name"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "whatsapp": {
      "type": "string",
      "title": "WhatsApp"
    },
    "website": {
      "type": "string",
      "title": "Website"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "services": {
      "type": "string",
      "title": "Services Offered"
    },
    "internal_notes": {
      "type": "string",
      "title": "Internal Notes"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "active",
        "inactive",
        "preferred",
        "needs_review"
      ],
      "default": "active"
    },
    "photos": {
      "type": "array",
      "title": "Photos",
      "items": {
        "type": "string"
      }
    },
    "documents": {
      "type": "array",
      "title": "Documents",
      "items": {
        "type": "string"
      }
    },
    "commission_percentage": {
      "type": "number",
      "title": "Commission Percentage"
    },
    "internal_pricing_notes": {
      "type": "string",
      "title": "Internal Pricing Notes"
    }
  },
  "required": [
    "supplier_name",
    "category"
  ]
}