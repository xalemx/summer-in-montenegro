{
  "name": "Destination",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "slug": {
      "type": "string",
      "title": "Slug"
    },
    "region_id": {
      "type": "string",
      "title": "Region ID"
    },
    "region_name": {
      "type": "string",
      "title": "Region Name"
    },
    "type": {
      "type": "string",
      "title": "Type",
      "enum": [
        "town",
        "city",
        "village",
        "resort",
        "island"
      ]
    },
    "overview": {
      "type": "string",
      "title": "Overview"
    },
    "highlights": {
      "type": "string",
      "title": "Highlights"
    },
    "best_for": {
      "type": "string",
      "title": "Best For"
    },
    "hero_image": {
      "type": "string",
      "title": "Hero Image",
      "format": "uri"
    },
    "photos": {
      "type": "array",
      "title": "Photos",
      "items": {
        "type": "string"
      }
    },
    "latitude": {
      "type": "number",
      "title": "Latitude"
    },
    "longitude": {
      "type": "number",
      "title": "Longitude"
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    }
  },
  "required": [
    "name",
    "region_id"
  ]
}